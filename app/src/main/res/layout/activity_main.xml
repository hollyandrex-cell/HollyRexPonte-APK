<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0c14">

    <!-- WEBVIEW OFFLINE V5 - OCCUPA TUTTO LO SCHERMO SOPRA -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- PANNELLO PONTE SOTTO - COMPATTO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#1e293b">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💛 V5 OFFLINE - Ponte NOSTRO"
            android:textColor="#f8d59e"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="#0f172a"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/inputDeviceId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="deviceId es: device_abc123 o tutti"
                android:textColor="#f8d59e"
                android:textColorHint="#94a3b8"
                android:backgroundTint="#334155"
                android:textSize="12sp"
                android:padding="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnPermesso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔔 Permesso"
                android:textSize="11sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnAvvia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Avvia Ponte"
                android:textSize="11sp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧪 Test"
                android:textSize="11sp"
                android:layout_marginStart="3dp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
